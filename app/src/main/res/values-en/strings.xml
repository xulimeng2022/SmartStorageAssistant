    <string name="changelog_title">v1.1.0 release notes</string>
    <string name="changelog_new">New</string>
    <string name="changelog_new_1">Three interface languages: Simplified Chinese, Traditional Chinese, and English (follow system / manual)</string>
    <string name="changelog_new_2">Redesigned dark mode with WeChat-style layered dark-grey surfaces</string>
    <string name="changelog_fix">Fixed</string>
    <string name="changelog_fix_1">AI parsing failures (timeouts, unavailable service, etc.) no longer dead-end: choose “Configure API” or “Later”; “Later” falls back to local rule parsing and keeps the result so you can continue, without repeating the dialog in the same session</string>
    <string name="changelog_fix_2">Fixed photo assignment in batch recognition (multi photos per item, shared photos, retry after partial failure)</string>
    <string name="changelog_fix_3">Added full-screen zoomable photo preview and clear, categorized model errors</string>
    <string name="changelog_ok">Got it</string>
